{
  "name": "wota-technology",
  "private": true,
  "version": "1.0.0",
  "description": "WOTA Solutions — physical-to-digital marketing site.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "basic-ftp": "^6.2.1",
    "vite": "^5.4.11"
  }
}
