# Afrihost FTP deploy settings — copy this file to `.env` and fill in.
# Find these in Afrihost ClientZone → your hosting → FTP Accounts / cPanel.
# `.env` is git-ignored; never commit real credentials.

FTP_HOST=ftp.wota.africa
FTP_USER=your_cpanel_or_ftp_username
FTP_PASSWORD=your_password
FTP_PORT=21
FTP_SECURE=true
# Docroot of the home.wota.africa subdomain: the `home` folder at the account
# root (/home/<user>/home), a sibling of public_html. FTP lands in the account
# home dir, so this is just `home`. (WordPress lives in public_html — untouched.)
FTP_REMOTE_DIR=home
