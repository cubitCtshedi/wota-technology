# Afrihost FTP deploy settings — copy this file to `.env` and fill in.
# Find these in Afrihost ClientZone → your hosting → FTP Accounts / cPanel.
# `.env` is git-ignored; never commit real credentials.

FTP_HOST=ftp.wota.africa
FTP_USER=your_cpanel_or_ftp_username
FTP_PASSWORD=your_password
FTP_PORT=21
FTP_SECURE=true
# Where to upload, relative to where the FTP account lands on login:
#   - A dedicated FTP account scoped to the home.wota.africa docroot logs
#     straight into the site folder  → use "."  (this is our setup)
#   - The master cPanel account lands in the home dir (sibling of public_html)
#     → use "home"
FTP_REMOTE_DIR=.
